#include<iostream>
using namespace std;
int AppearOnceOtherTwice(vector<int> &a, int n){
    int num;
    int cnt;
    for(int i = 0; i < n; i++){
        num = a[i];
        cnt = 0;
        for(int j = 0; j < n; j++){
            if(a[j] == num){
                cnt++;
            }
        }
        if(cnt == 1){
            return num;
        }
           
        
    }
        return -1;
}
int main()
{
int n ;
cin>>n;
vector<int> a(n);
for(int i = 0; i < n; i++){
    cin>> a[i];
}

cout<< AppearOnceOtherTwice(a,n) << endl;
return 0;
}
