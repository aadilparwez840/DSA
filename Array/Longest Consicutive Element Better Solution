#include<iostream>
using namespace std;
int LongestSuccesiveElement(vector<int> &num){
    if(num.size() == 0) return 0;
    sort(num.begin(), num.end());
    int n = num.size();
    int longest = 1;
    int lastSmaller = INT_MIN;
    int cnt = 0;
    for(int i = 0; i < n; i++){
        if(num[i] - 1 == lastSmaller){
            cnt +=1;
            lastSmaller = num[i];
        }
        else if(lastSmaller != num[i]){
            cnt = 1;
            lastSmaller = num[i];
        }
        longest = max(longest, cnt);

    }
    return longest;
}
int main()
{
int n;
cin>> n;
vector<int> num(n);
for(int i = 0; i < n; i++){
    cin >> num[i];
}
cout << "Longest Consicutive Length is : "<<LongestSuccesiveElement(num) << endl;

return 0;
}
