#include<iostream>
#include<map>
using namespace std;
int MajorityElement(vector<int> v){
    map<int,int> mpp;
    for(int i = 0; i < v.size(); i++){
        mpp[v[i]]++;

    }
    for(auto it: mpp){
        if (it.second > (v.size() / 2)){
            return it.first;
        }
    }
    return -1;
}
int main()
{
 int n;
    cin >> n;

    vector<int> v(n);

    for (int i = 0; i < n; i++) {
        cin >> v[i];
    }

    cout << MajorityElement(v);

return 0;
}
