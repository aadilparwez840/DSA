#include<iostream>
using namespace std;
int Missingnumber(vector<int> &A, int N){
int xor1 = 0;
int xor2 = 0;
int n = N-1;
for(int i = 0; i < n; i++){
    xor2 = xor2 ^ A[i];
    xor1 = xor1 ^ (i+1);

}
 xor1 = xor1 ^ N;
return xor1 ^ xor2 ;
}

int main()
{
int N;

    cout << "Enter N: ";
    cin >> N;

    vector<int> A(N - 1);

    cout << "Enter " << N - 1 << " elements: ";
    for (int i = 0; i < N - 1; i++) {
        cin >> A[i];
    }

    int missing = Missingnumber(A, N);

    cout << "Missing number is: " << missing << endl;
return 0;
}
