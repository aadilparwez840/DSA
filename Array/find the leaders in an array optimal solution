//  leaders are those elemnt in which right element is smallest element

#include<iostream>
using namespace std;
vector<int> LeadersInArray(vector<int> &a){
    vector<int> ans;
    int maxi = INT_MIN;
    int n = a.size();
    // 0(N)
    for(int i = n-1; i >= 0; i--){
        if(a[i] > maxi){
            ans.push_back(a[i]);
        }
        // keep track of right max
        maxi = max(maxi, a[i]);

    }
    // 0(NlogN)
    sort(ans.begin(), ans.end());
    return ans;
}
int main()
{
int n;
cin >> n;
vector<int> a(n);
for(int i = 0; i < n; i++){
    cin >> a[i];
}
vector<int> ans = LeadersInArray(a);

    cout << "Leaders in the array: ";
    for (int x : ans) {
        cout << x << " ";
    }


return 0;
}
